# ── Secrets & environment (NEVER commit) ─────────────────────
.env
.env.*
!.env.example

# ── Runtime data (not source; stays on disk, just untracked) ─
/uploads/
/error_log
error_log
*.log
.installed

# ── Backups plugin local staging (deleted after each run; a live DB
#    dump full of customer PII must never be committed) ─────
/db_backups/*
!/db_backups/.gitkeep

# ── Build artifacts / packaged plugins ───────────────────────
/plugins/_dist/
/plugins/*.zip
/docs.zip
/slate-root.zip

# ── Local tool / editor state — never commit ─────────────────
.claude/settings.local.json

# ── Scratch / temp / editor ──────────────────────────────────
/scratchpad/
*.bak
*.tmp
*~
.DS_Store
.idea/
.vscode/

# ── Dependencies fetched by tooling (PHPMailer vendored copy is
#    kept intentionally — see composer.json; do NOT ignore vendor/) ─
node_modules/

# ── Test output ──────────────────────────────────────────────
/tests/.out/

# ── Deployment archives & local backups (added with the CI pipeline) ─
/slate-deployment.zip
/*.zip
*.prebackup.*
*.pre-icons.bak
/config.php.backup*
/tests/_tmp_*.php

# cPanel/FTP server artifact — regenerated by the host, never source.
/.ftpquota

# ── Deployment package: build artifact + DB dump, never source ─
#    The zip bundles a live .env (DB_PASS/APP_SECRET) and the SQL
#    dump carries password hashes and API tokens.
/deploy-package/

# Timestamped editor backups (e.g. foo.php.bak-1788608068)
*.bak-*
*.bak.*
