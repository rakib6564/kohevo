# ============================================================
# Slate — environment configuration
# ============================================================
# Copy this file to `.env` and fill in real values for your install.
# The .env file is loaded by config.php for local/dev. In production
# you should prefer setting these as environment variables in your
# hosting panel instead of using .env on disk.
#
# DO NOT commit .env to version control.
# ============================================================

# Public URL of this install. No trailing slash.
APP_URL=https://your-domain.example

# Application secret — used for HMAC signatures and secret encryption.
# Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-64-random-hex-chars

# Cron secret — protects cron.php against unauthenticated hits.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-another-64-random-hex-chars

# MCP gateway — off by default. Set to 1 only when you intend to let an
# AI agent connect via plugins/mcp-gateway. This is a second, independent
# kill switch from the plugin's own active/inactive state (see
# plugins/mcp-gateway/README.md for why one switch alone isn't enough).
MCP_GATEWAY_ENABLED=0

# Tenant id for a single-tenant install. Leave at 1 unless you
# explicitly run multi-tenant.
TENANT_ID=1

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
# Optional — only needed if your MySQL/MariaDB listens on a non-default
# port (e.g. a local XAMPP instance sharing a box with another MySQL).
# DB_PORT=3306
DB_NAME=slate
DB_USER=slate
DB_PASS=change-me
DB_CHARSET=utf8mb4
